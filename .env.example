# Environment Variables Reference for Exaqube Analytics

# PostgreSQL Database URL
DATABASE_URL=postgresql+asyncpg://exaqube:exaqube_dev@localhost:5432/exaqube

# FREE LLM Option 1: Groq API Key (100% Free - Get key at https://console.groq.com/keys)
GROQ_API_KEY=

# FREE LLM Option 2: Google Gemini API Key (100% Free - Get key at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# OpenAI API Key (Paid option)
OPENAI_API_KEY=
LLM_MODEL=
